{
    "version": "0.2.13",
    "description": "Local AI, tuned to one model. Runs open-weight models on your own GPU.",
    "homepage": "https://github.com/Niko1221/Strata",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Niko1221/Strata/releases/download/v0.2.13/Strata-0.2.13-windows-x64-setup.exe",
            "hash": "0da27b00200797a85d79211245ecb094dbe5d0bab7f958b1defdf26fee55627b"
        }
    },
    "installer": {
        "script": [
            "& \"$dir\\Strata-0.2.13-windows-x64-setup.exe\" /S",
            "$strataApp = Join-Path $env:LOCALAPPDATA 'Programs\\Strata'; $strataExe = Join-Path $strataApp 'strata-desktop.exe'; $strataDeadline = (Get-Date).AddMinutes(5); do { Start-Sleep -Seconds 2 } while ((Get-Date) -lt $strataDeadline -and -not (Test-Path $strataExe)); if (-not (Test-Path $strataExe)) { throw 'Strata installer did not complete' }"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path \"$env:LOCALAPPDATA\\Programs\\Strata\") { Remove-Item -Recurse -Force \"$env:LOCALAPPDATA\\Programs\\Strata\" }"
        ]
    },
    "checkver": {
        "github": "https://github.com/Niko1221/Strata"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Niko1221/Strata/releases/download/v$version/Strata-$version-windows-x64-setup.exe"
            }
        }
    },
    "notes": "NSIS installer (per-user): installs to %LOCALAPPDATA%\\Programs\\Strata and creates Start Menu/Desktop shortcuts. Updates go through the app's own updater or 'scoop update strata'.",
    "post_install": [
        "$strataExe = \"$env:LOCALAPPDATA\\Programs\\Strata\\strata-desktop.exe\"",
        "$desktop = [Environment]::GetFolderPath('Desktop')",
        "$smp = \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\"",
        "$wsh = New-Object -ComObject WScript.Shell",
        "$lnk = $wsh.CreateShortcut(\"$desktop\\Strata.lnk\"); $lnk.TargetPath = $strataExe; $lnk.Save()",
        "$lnk2 = $wsh.CreateShortcut(\"$smp\\Strata.lnk\"); $lnk2.TargetPath = $strataExe; $lnk2.Save()"
    ]
}
