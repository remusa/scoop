            "hash": "sha256:29a4f1c77f6c95304e6151f6140f1011f7efd18c689bd9c378e1bc2cb36bfce5"
        },
        "arm64": {
            "url": "https://github.com/netbirdio/netbird/releases/download/v0.73.1/netbird_installer_0.73.1_windows_arm64.exe",
            "hash": "sha256:1e51de4e5a76ccae8ea9a22b664afaa545f07ed029bb663d47d57cb666b27cd7"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\$fname\" -ArgumentList '/S', \"/D=$dir\" -Wait"
        ]
    },
    "uninstaller": {
        "script": [
            "Stop-Service -Name 'NetBird Agent' -ErrorAction SilentlyContinue",
            "if (Test-Path \"$dir\\Uninstall.exe\") { Start-Process -FilePath \"$dir\\Uninstall.exe\" -ArgumentList '/S' -Wait }"
        ]
    },
    "bin": [
        "netbird.exe",
        "netbird-ui.exe"
    ],
    "checkver": {
        "github": "https://github.com/netbirdio/netbird"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/netbirdio/netbird/releases/download/v$version/netbird_installer_$version_windows_amd64.exe"
            },
            "arm64": {
                "url": "https://github.com/netbirdio/netbird/releases/download/v$version/netbird_installer_$version_windows_arm64.exe"
            }
        }
    }
}
